filters:
  and:
    - file.folder == "Tasks"
    - note.status && note.status != "" && note.status != null
formulas:
  source_link: 'if(source, link(source.toString(), "Open"))'
properties:
  file.name:
    displayName: Task
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.projects:
    displayName: Projects
  formula.source_link:
    displayName: Source
  note.due:
    displayName: Due
  note.scheduled:
    displayName: Scheduled
views:
  - type: tasknotesTaskList
    name: Tasks
    filters:
      and:
        - status != "done"
    groupBy:
      property: projects
      direction: ASC
    order:
      - status
      - priority
      - projects
      - formula.source_link
      - due
      - scheduled
      - file.name
    options:
      showScheduled: true
      showDue: true
      showRecurring: false
      showTimeEntries: false
  - type: table
    name: Table
    order:
      - file.name
      - status
      - priority
      - projects
      - due
      - scheduled
    sort:
      - property: projects
        direction: DESC
      - property: status
        direction: DESC
    columnSize:
      file.name: 360
      note.status: 130
      note.priority: 120
      note.projects: 220
      note.due: 140
      note.scheduled: 140
  - type: tasknotesKanban
    name: Kanban
    groupBy:
      property: status
      direction: ASC
    order:
      - status
      - priority
      - projects
      - due
      - scheduled
      - file.name
    options:
      columnWidth: 280
      hideEmptyColumns: false
    swimLane: note.status
    explodeListColumns: true
