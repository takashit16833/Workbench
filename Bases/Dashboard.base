properties:
  file.name:
    displayName: Name
  note.projects:
    displayName: Projects
  note.status:
    displayName: Status
  note.review_gate:
    displayName: Review Gate
  note.created:
    displayName: Created
views:
  - type: table
    name: Ideas
    filters:
      and:
        - file.folder == "Ideas"
        - file.ext == "md"
        - status == "active"
    order:
      - file.name
      - projects
      - status
      - review_gate
      - created
    columnSize:
      file.name: 320
      note.projects: 220
      note.status: 120
      note.review_gate: 420
      note.created: 140
