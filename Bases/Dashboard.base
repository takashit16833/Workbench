properties:
  file.name:
    displayName: Name
  note.projects:
    displayName: Projects
  note.review_gate:
    displayName: Review Gate
  note.created:
    displayName: Created
views:
  - type: table
    name: Ideas
    filters:
      and:
        - file.folder == "Ideas"
        - file.ext == "md"
    order:
      - file.name
      - projects
      - review_gate
      - created
    columnSize:
      file.name: 320
      note.projects: 220
      note.review_gate: 420
      note.created: 140
  - type: table
    name: Projects
    filters:
      and:
        - file.folder == "Projects"
        - file.ext == "md"
    order:
      - file.name
    columnSize:
      file.name: 320
