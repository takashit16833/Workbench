    {"id":"e-runtime-core","fromNode":"runtime","toNode":"core","label":"共通型 / ToEventSpec","fromSide":"top","toSide":"bottom"},
    {"id":"e-backend-core","fromNode":"backend","toNode":"core","label":"LogEvent / JSON化対象型","fromSide":"top","toSide":"bottom"},
    {"id":"e-backend-runtime","fromNode":"backend","toNode":"runtime","label":"Sink / LoggingFailure","fromSide":"top","toSide":"bottom"},
    {"id":"e-setup-uuid","fromNode":"setup","toNode":"uuid","label":"nextRandom","fromSide":"right","toSide":"left"},
    {"id":"e-setup-time","fromNode":"setup","toNode":"time","label":"getCurrentTime","fromSide":"right","toSide":"left"},
    {"id":"e-backend-aeson","fromNode":"backend","toNode":"aeson","label":"JSON encode","fromSide":"right","toSide":"left"},
    {"id":"e-backend-stderr","fromNode":"backend","toNode":"stderr","label":"1行出力 + flush","fromSide":"right","toSide":"left"},
    {"id":"e-backend-ioexc","fromNode":"backend","toNode":"ioexception","label":"try / failure mapping","fromSide":"right","toSide":"left"}
  ]
}
